# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/renthub

# Scraper behavior
REQUEST_DELAY=2
MAX_CONCURRENT_REQUESTS=2
MAX_PAGES=
DOWNLOAD_IMAGES=false
REMOVED_AFTER_MISSING_SCANS=3

# Timezone
TZ=Asia/Bangkok

# API
API_HOST=0.0.0.0
API_PORT=8000

# Auth (page de connexion)
# SECRET_KEY signe le cookie de session: laissée à la valeur ci-dessous,
# elle est connue de quiconque lit le dépôt et un cookie valide se forge
# sans mot de passe. L'API REFUSE DE DÉMARRER tant que SECRET_KEY et
# SITE_PASSWORD n'ont pas été remplacées.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SITE_USERNAME=admin
SITE_PASSWORD=changeme
SECRET_KEY=change-this-to-a-random-secret
# OAuth Google (facultatif): identifiants d'un client "Application Web" créé
# dans Google Cloud Console, avec <origine>/auth/google/callback comme URI de
# redirection autorisée. Vides = bouton Google absent de la page de connexion.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Mettre à true dès que l'app est servie en HTTPS
COOKIE_SECURE=false
# Origines autorisées à appeler l'API depuis un autre site, séparées par des
# virgules. Vide = aucune: le frontend est servi par la même application, les
# appels sont donc same-origin et n'ont pas besoin du CORS.
CORS_ALLOW_ORIGINS=
